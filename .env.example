# Supabase (as chaves ja existem — copiar do painel)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Produto
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_GROUP=https://chat.whatsapp.com/XXXXXXXXXXXXXXX

# Hash de IP para rate limit (qualquer string longa e aleatoria)
IP_HASH_SALT=troque-isto-em-producao

# FONTE DOS DADOS — chave do HenrikDev (https://docs.henrikdev.xyz).
# E o unico caminho que funciona hoje: a API publica da Tracker Network nao
# serve Valorant e o endpoint interno do tracker.gg responde 403.
# Chave basica = 30 requisicoes por minuto; uma busca fria gasta 3.
HENRIKDEV_API_KEY=

# Caminho antigo, mantido so por compatibilidade. A API publica da Tracker
# Network nao cobre Valorant, entao isto nao resolve uma busca de Valorant.
TRN_API_KEY=

# 1 = tenta ler o Tracker Score do HTML do perfil. Hoje esbarra no Cloudflare;
# desligado, o score sai estimado pelos percentis (erro de 1 a 4 pontos).
LER_SCORE_HTML=0

# Dev: 1 = nao chama o tracker.gg, usa fixtures locais (heat#912, dedada#6625).
# Ignorado quando NODE_ENV=production.
MOCK_TRACKER=0
